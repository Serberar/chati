{
  "checkpoint_loader": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "__CHECKPOINT_PATH__" }
  },
  "clip_loader": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "t5xxl_fp8_e4m3fn.safetensors", "type": "ltxv", "device": "default" }
  },
  "positive_encode": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["clip_loader", 0], "text": "__PROMPT__" }
  },
  "negative_encode": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["clip_loader", 0],
      "text": "low quality, worst quality, deformed, distorted, disfigured, motion smear, motion artifacts, fused fingers, bad anatomy, weird hand, ugly"
    }
  },
  "empty_latent_video": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": { "width": "__WIDTH__", "height": "__HEIGHT__", "length": "__LENGTH__", "batch_size": 1 }
  },
  "ltxv_conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["positive_encode", 0],
      "negative": ["negative_encode", 0],
      "frame_rate": "__FPS__"
    }
  },
  "scheduler": {
    "class_type": "LTXVScheduler",
    "inputs": {
      "steps": "__STEPS__",
      "max_shift": 2.05,
      "base_shift": 0.95,
      "stretch": true,
      "terminal": 0.1,
      "latent": ["empty_latent_video", 0]
    }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "sampler_custom": {
    "class_type": "SamplerCustom",
    "inputs": {
      "model": ["checkpoint_loader", 0],
      "add_noise": true,
      "noise_seed": "__SEED__",
      "cfg": "__CFG__",
      "positive": ["ltxv_conditioning", 0],
      "negative": ["ltxv_conditioning", 1],
      "sampler": ["sampler_select", 0],
      "sigmas": ["scheduler", 0],
      "latent_image": ["empty_latent_video", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler_custom", 0], "vae": ["checkpoint_loader", 2] }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["vae_decode", 0], "fps": "__FPS__" }
  },
  "save_video": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["create_video", 0], "filename_prefix": "ia_personal_video", "format": "auto" }
  }
}

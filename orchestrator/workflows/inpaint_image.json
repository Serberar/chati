{
  "checkpoint_loader": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "__CHECKPOINT_PATH__" }
  },
  "load_image": {
    "class_type": "LoadImage",
    "inputs": { "image": "__IMAGE_FILENAME__" }
  },
  "load_mask": {
    "class_type": "LoadImageMask",
    "inputs": { "image": "__MASK_FILENAME__", "channel": "red" }
  },
  "positive_encode": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["checkpoint_loader", 1], "text": "__PROMPT__" }
  },
  "negative_encode": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["checkpoint_loader", 1],
      "text": "low quality, worst quality, deformed, distorted, disfigured, blurry, bad anatomy, seams, visible edges"
    }
  },
  "vae_encode_inpaint": {
    "class_type": "VAEEncodeForInpaint",
    "inputs": {
      "pixels": ["load_image", 0],
      "vae": ["checkpoint_loader", 2],
      "mask": ["load_mask", 0],
      "grow_mask_by": 6
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["checkpoint_loader", 0],
      "seed": "__SEED__",
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": ["positive_encode", 0],
      "negative": ["negative_encode", 0],
      "latent_image": ["vae_encode_inpaint", 0],
      "denoise": "__DENOISE__"
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["checkpoint_loader", 2] }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": { "images": ["vae_decode", 0], "filename_prefix": "ia_personal_inpaint" }
  }
}

{
  "checkpoint_loader": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "__CHECKPOINT_PATH__" }
  },
  "load_face_image": {
    "class_type": "LoadImage",
    "inputs": { "image": "__IMAGE_FILENAME__" }
  },
  "faceid_unified_loader": {
    "class_type": "IPAdapterUnifiedLoaderFaceID",
    "inputs": {
      "model": ["checkpoint_loader", 0],
      "preset": "FACEID",
      "lora_strength": 0.6,
      "provider": "CPU"
    }
  },
  "faceid_apply": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["faceid_unified_loader", 0],
      "ipadapter": ["faceid_unified_loader", 1],
      "image": ["load_face_image", 0],
      "weight": 1.0,
      "weight_faceidv2": 1.0,
      "weight_type": "linear",
      "combine_embeds": "average",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "positive_encode": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["checkpoint_loader", 1], "text": "__PROMPT__" }
  },
  "negative_encode": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["checkpoint_loader", 1],
      "text": "low quality, worst quality, deformed, distorted, disfigured, blurry, bad anatomy, extra limbs, cartoon, illustration, anime"
    }
  },
  "empty_latent": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "__WIDTH__", "height": "__HEIGHT__", "batch_size": 1 }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["faceid_apply", 0],
      "seed": "__SEED__",
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": ["positive_encode", 0],
      "negative": ["negative_encode", 0],
      "latent_image": ["empty_latent", 0],
      "denoise": 1.0
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["checkpoint_loader", 2] }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": { "images": ["vae_decode", 0], "filename_prefix": "ia_personal_faceid" }
  }
}

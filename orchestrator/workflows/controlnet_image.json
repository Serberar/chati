{
  "checkpoint_loader": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "__CHECKPOINT_PATH__" }
  },
  "load_control_image": {
    "class_type": "LoadImage",
    "inputs": { "image": "__CONTROL_IMAGE_FILENAME__" }
  },
  "controlnet_loader": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "controlnet-union-sdxl-1.0-promax.safetensors" }
  },
  "controlnet_set_type": {
    "class_type": "SetUnionControlNetType",
    "inputs": { "control_net": ["controlnet_loader", 0], "type": "__CONTROL_TYPE__" }
  },
  "positive_encode": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["checkpoint_loader", 1], "text": "__PROMPT__" }
  },
  "negative_encode": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["checkpoint_loader", 1],
      "text": "low quality, worst quality, deformed, distorted, disfigured, blurry, bad anatomy, extra limbs, cartoon, illustration, anime"
    }
  },
  "controlnet_apply": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["positive_encode", 0],
      "negative": ["negative_encode", 0],
      "control_net": ["controlnet_set_type", 0],
      "image": ["load_control_image", 0],
      "strength": "__STRENGTH__",
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "empty_latent": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "__WIDTH__", "height": "__HEIGHT__", "batch_size": 1 }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["checkpoint_loader", 0],
      "seed": "__SEED__",
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": ["controlnet_apply", 0],
      "negative": ["controlnet_apply", 1],
      "latent_image": ["empty_latent", 0],
      "denoise": 1.0
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["checkpoint_loader", 2] }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": { "images": ["vae_decode", 0], "filename_prefix": "ia_personal_controlnet" }
  }
}
